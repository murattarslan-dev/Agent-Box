# Bu dosyayı elle doldurmana gerek yok: ./up.sh ilk çalıştırmada sihirbazla .env'i oluşturur
# (yeniden: ./up.sh setup). Aşağısı referans ve isteğe bağlı ayarlar içindir.

# ---- Zorunlu ----
# Kendi makinende `claude setup-token` çalıştır, çıkan token'ı yapıştır (Pro/Max abonelik).
CLAUDE_CODE_OAUTH_TOKEN=

# @BotFather'dan alınan bot token'ı
TELEGRAM_BOT_TOKEN=

# Sadece bu kullanıcılar bota komut verebilir (virgülle ayır). ID'ni öğrenmek için bota /whoami yaz.
TELEGRAM_ALLOWED_USER_IDS=

# https ile repo adresi (ssh desteklenmez)
REPO_URL=https://github.com/owner/repo.git

# GitHub: fine-grained PAT — Contents: Read/Write, Pull requests: Read/Write, Metadata: Read
# GitLab: Project Access Token — role Developer, scopes: api, read_repository, write_repository
REPO_TOKEN=

# ---- İsteğe bağlı ----
# github | gitlab  (boşsa REPO_URL host'undan tahmin edilir; self-hosted için ver)
GIT_PROVIDER=

# Ajanın commit kimliği
GIT_USER_NAME="Claude Agent"
GIT_USER_EMAIL=claude-agent@noreply.local

# Model (boş = Claude Code varsayılanı). Örn: claude-sonnet-4-5, claude-opus-4-1
CLAUDE_MODEL=

# Tek görevde en fazla tur
MAX_TURNS=400

# ---- Token tasarrufu ----
# Alt-ajan modelleri: review ve keşif ana modelden ucuz bir modelde koşar (sonnet | haiku | opus | tam ad)
MODEL_REVIEW=sonnet
MODEL_EXPLORE=haiku
# Gürültülü Bash komutlarında (build/test/paket) modele gösterilecek son satır sayısı; tam log /data/logs (0 = kapalı)
BASH_TAIL_LINES=80

# true: review geçince PR onayı sormadan PR aç
AUTO_PR=false

# true: onay kapıları kapalı (ajan sormadan yazar/push'lar). Sadece deneme reposunda!
FREE_MODE=false

# ---- Büyük dosya linkleri (APK > 50 MB) ----
# tunnel: Cloudflare quick tunnel — hesap gerekmez, her yerden indirilir (varsayılan)
# lan   : PUBLIC_BASE_URL ile kendi adresin (aynı Wi-Fi: http://<PC-LAN-IP>:8787)   off: kapalı
FILE_LINKS=tunnel
PUBLIC_BASE_URL=
FILE_PORT=8787
LINK_TTL_HOURS=24

# Saat dilimi (limit sıfırlanma saatleri bu dilimde gösterilir)
TZ=Europe/Istanbul

# debug: Claude Code stderr'ını da logla
LOG_LEVEL=info

# Kalıcı veri (repo, oturumlar, cache'ler) için host dizini — docker compose kullanır
DATA_PATH=./data

# ---- SDK sürümleri ----
# Kaynak sırası: repo'daki .sdks dosyası (satır başına "isim sürüm"; tavsiye edilen, kalıcı)
#              > buradaki SDKS (sihirbaz yazar)  > tahmin (.fvmrc / .tool-versions / pubspec Dart sürümü)
# Örnek: SDKS=flutter:3.24.5,jdk:17,android:34    Kapat: SDKS=none
# Desteklenen: jdk android flutter dart go node rust. Sürümler projeyi bilgisayarında build edenlerle aynı olmalı.
# Tek tek ezmek için: FLUTTER_VERSION= JDK_VERSION= ANDROID_API=

# ---- SDK volume'ları ----
# up.sh her SDK için sdk-<isim>-<sürüm> volume'u yoksa BİR KERE kurar, varsa bağlar (aynı makinedeki tüm container'lar paylaşır).
SDKS=

# Kubernetes için (up.sh --k8s)
K8S_NAMESPACE=claude-agent
K8S_STORAGE_SIZE=20Gi
# K8S_STORAGE_CLASS=
# SDK PVC'leri: tek node'da ReadWriteOnce yeter; çok node + paylaşım için ReadWriteMany destekleyen sınıf ver
K8S_SDK_ACCESS_MODE=ReadWriteOnce
K8S_SDK_SIZE_BIG=10Gi
IMAGE=claude-telegram-agent:latest

# --- Ekran görüntüsü (/ss, screenshot skill'i) — isteğe bağlı
# Telefondan bakmak için token gerekmez: /preview link verir, girişi kendin yaparsın.
# Yalnızca botun giriş ARKASINDAKİ ekranların fotoğrafını çekmesini istiyorsan: test kullanıcısının token'ı;
# CLAUDE.md ```screenshot bloğundaki "storage: <anahtar>=$APP_TEST_TOKEN" satırı bunu localStorage'a yazar. Prod token koyma.
#APP_TEST_TOKEN=

# ---- APK nerede üretilsin ----
# local  : container'da flutter + gradle (JDK/Android SDK volume'ları gerekir; 4-6 GB RAM tepe)  (varsayılan)
# actions: GitHub Actions'ta (/apk setup workflow'u ekler). Container'da yalnızca Flutter SDK yeter → SDKS=flutter:<sürüm>
#          REPO_TOKEN izinleri: "Workflows: Read and write" (workflow dosyasını push için) + "Actions: Read and write"
#          (tetikleme + artifact). Railway gibi PaaS'larda tavsiye edilen.
APK_BUILDER=local
APK_WORKFLOW=agent-apk.yml
# Actions → bot ping'i (isteğe bağlı; beklemeyi kısaltır ve push tetiklemeli koşuların APK'sını kendiliğinden gönderir).
# Rastgele bir dize üret (openssl rand -hex 16); aynısını repo secrets'a AGENT_WEBHOOK_SECRET olarak koy,
# AGENT_WEBHOOK_URL = https://<bot-adresi>/hook/build
#BUILD_WEBHOOK_SECRET=

# ---- PaaS (Railway / Render / Fly) ----
# up.sh yok: SDK'lar açılışta arka planda /data/sdks'e kurulur (volume'da kalıcı). Ayrıntı: docs/railway.md
#SDK_AUTOINSTALL=1
# Platform PORT verir; bot HTTP sunucusu onu kullanır. Tünel gerekmez:
#FILE_LINKS=lan
#PUBLIC_BASE_URL=https://<servis>.up.railway.app
